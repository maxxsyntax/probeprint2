# probeprint2 configuration -- copy to .env and fill in:
#
#     cp .env.example .env
#
# .env is gitignored because it holds credentials and engagement-specific
# targeting. This template is safe to commit -- placeholders only, no real data.
# It is sourced as bash, so every line is a shell assignment; quote values that
# contain spaces or shell metacharacters.

# ── Required ──────────────────────────────────────────────────────────────────

# WiGLE API credentials as name:token, passed to `curl -u` for location lookups.
# Create a token at https://wigle.net/account.
APIKEY="wigle_api_name:wigle_api_token"

# Monitor-mode capture interface(s). Used by build_ssid.sh. A whitespace-
# separated list, so several radios can watch different channels at once -- the
# reason to add a second interface at all, since one only hears the channel it
# is parked on. Each token is an interface, optionally iface:channel:
#   INF="wlan1mon"                        one interface, current channel
#   INF="wlan1mon:6"                      one interface, forced to channel 6
#   INF="wlan1mon:1 wlan2mon:6 wlan3mon:11"   three radios, three channels
INF="wlan1mon"

# Live WiGLE lookups during capture: 1 enables, anything else skips them. Off by
# default so a rate-limited HTTP call never sits in the ingest hot loop; run the
# lookups post-capture with ./summarize_location.sh --new instead.
online=0

# ── Optional: geolocation ─────────────────────────────────────────────────────

# WiGLE response cache directory, read offline by the geolocate pass.
#GEO_LOCS_DIR=locs

# Run the offline geolocate pass during capture too. Off by default: a
# rate-limited round trip in the ingest loop costs frames.
#geo_online=0

# Seconds to wait out a WiGLE quota exhaustion before retrying, for the
# --on-quota=wait path used by ssid2loc_every24.sh.
#WIGLE_WAIT=600

# Google Geolocation API key. Enables the observer-position provider (needs >=2
# BSSIDs). Empty = disabled.
#GOOGLE_GEOLOCATION_KEY=

# Nominatim reverse geocoding. OSM policy is 1 request/second with an
# identifying User-Agent -- set a real contact string before running at scale.
#GEO_NOMINATIM_SLEEP=1
#GEO_USER_AGENT=probeprint2-geolocate

# Apple's undocumented BSSID endpoint. Off by default: there is no public API and
# it returns data on hundreds of unrelated third-party APs per query, so enabling
# it is an engagement-owner decision (see geolocate_functions.sh).
#GEO_ENABLE_APPLE=0

# ── Optional: device sequence-graph tuning ────────────────────────────────────
# See FINGERPRINTING.md. Run ./standalone_seqgraph.sh --validate on a real
# capture to tune these per site rather than guessing.

#SEQGRAPH_ALPHA=90      # max seconds between two chained probes
#SEQGRAPH_BETA=400      # max sequence-number gap between two chained probes
#SEQGRAPH_GATE_IE=1     # require a matching IE fingerprint to chain (1=on)

# ── Optional: enrichment tuning ───────────────────────────────────────────────

# Shortest token the industry/recategorize keyword miner will consider.
#INDUSTRY_MIN_LEN=4

# ── Optional: database connection ─────────────────────────────────────────────
# Default is a local socket as the current user. A remote capture node and the
# Docker import path point at a central server instead.

#DB_USER=pi
#DB_HOST=127.0.0.1

# Extra args for the display's mysql client. A single host can leave this unset;
# a remote capture node talking to a central server sets it.
#DISPLAY_DB_ARGS="-u pi -h 127.0.0.1"
#DISPLAY_WINDOW=30      # in-range window, seconds
#DISPLAY_REFRESH=5      # live view refresh interval, seconds

# ── Optional: engagement-specific targeting ───────────────────────────────────
# Keyword lists that flag SSIDs tied to this engagement's people, orgs and
# events. Kept out of git deliberately. `categories` is declared before .env is
# sourced, so these associative-array assignments are valid here. Values are
# semicolon-separated and matched case-insensitively against decoded SSIDs.
# Replace the placeholders with real targets in your .env only.
#
#categories["INDUSTRY_ORG"]="example-corp;examplecorp-wifi"
#categories["INDUSTRY_VIP"]="example-exec-device"
#categories["INDUSTRY_PERSON"]="example-handle;e.example"
#categories["INDUSTRY_EVENT"]="example-conf-2025;example-attendee-ssid"
